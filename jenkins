TASK 7 — Jenkins pipeline (Jenkinsfile) and GitHub webhook

Place this Jenkinsfile in repo root (replace <github-user> with your GitHub username):

pipeline {
  agent any
  environment {
    SSH_KEY = '/var/lib/jenkins/.ssh/surjan-key.pem'
  }
  stages {
    stage('Checkout') {
      steps {
        git branch: 'main', url: 'https://github.com/<github-user>/surjan-addressbook-cicd-project.git'
      }
    }
    stage('Build') {
      steps {
        sh 'mvn -B -DskipTests=false clean package'
      }
      post {
        always {
          archiveArtifacts artifacts: 'target/*.war', fingerprint: true
        }
      }
    }
    stage('Install Tomcat on App Node') {
      steps {
        sh "ansible-playbook -i ansible/inventories/hosts.ini ansible/playbooks/install_tomcat.yml --private-key ${SSH_KEY} -u ubuntu"
      }
    }
    stage('Deploy to Tomcat') {
      steps {
        sh "ansible-playbook -i ansible/inventories/hosts.ini ansible/playbooks/deploy_war.yml --private-key ${SSH_KEY} -u ubuntu"
      }
    }
  }
}


