TASK 3 — Terraform: provision the AWS infra (this has subparts)
Task 3a — Plan what Terraform will create

You need:

A security group allowing SSH (22), Jenkins (8080), Tomcat (8080 or 8081 if you prefer) and ephemeral outbound.

Two t2.micro EC2 instances:

surjan-jenkins-master (Jenkins server)

surjan-app-node (Tomcat / application node)

Use the existing manual key pair you will create in the console (name surjan-key) — Terraform will reference it by key_name (it will not create the key).

Region: eu-west-2.

Task 3b — Terraform code (copy these files exactly into terraform/)
versions.tf
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.0"
}

provider.tf
provider "aws" {
  region = var.aws_region
}

variables.tf
variable "aws_region" {
  type    = string
  default = "eu-west-2"
}

variable "key_name" {
  type    = string
  default = "surjan-key"
}

variable "instance_type" {
  type    = string
  default = "t2.micro"
}

variable "ssh_cidr" {
  description = "CIDR allowed to SSH (set to 0.0.0.0/0 for exam if you must; safer: your IP)"
  type        = string
  default     = "0.0.0.0/0"
}

main.tf
# Use Canonical's owner and pick latest Ubuntu Jammy 22.04
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]   # Canonical owner – ensures official Ubuntu images.
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

# Use the default VPC and first public subnet
data "aws_vpc" "default" {
  default = true
}

data "aws_subnet_ids" "default" {
  vpc_id = data.aws_vpc.default.id
}

resource "aws_security_group" "surjan_sg" {
  name        = "surjan-sg"
  description = "allow SSH, Jenkins, Tomcat"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_cidr]
  }

  ingress {
    description = "Jenkins (HTTP)"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "Tomcat"
    from_port   = 8081
    to_port     = 8081
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "surjan-sg"
  }
}

resource "aws_instance" "jenkins_master" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnet_ids.default.ids[0]
  key_name               = var.key_name
  vpc_security_group_ids = [aws_security_group.surjan_sg.id]

  tags = {
    Name = "surjan-jenkins-master"
  }
}

resource "aws_instance" "app_node" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnet_ids.default.ids[0]
  key_name               = var.key_name
  vpc_security_group_ids = [aws_security_group.surjan_sg.id]

  tags = {
    Name = "surjan-app-node"
  }
}

outputs.tf
output "jenkins_master_public_ip" {
  value = aws_instance.jenkins_master.public_ip
}

output "app_node_public_ip" {
  value = aws_instance.app_node.public_ip
}

output "security_group_id" {
  value = aws_security_group.surjan_sg.id
}


Notes:

The data.aws_ami approach uses Canonical’s account ID (099720109477) so you get official Ubuntu Jammy images and not a third-party AMI. This is the recommended pattern; it avoids hardcoding an AMI id which changes per region. 
